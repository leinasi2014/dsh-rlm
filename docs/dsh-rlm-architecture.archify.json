    "views": [
      {
        "id": "managed-context",
        "label": "M3 managed context",
        "focus": ["contextSource", "contextLoader", "sessionKernel", "rlmEval"],
        "note": "An absolute UTF-8 file becomes a protected Session-local context variable without copying its contents through the model-facing tool call."
      },
      {
        "id": "recursive-child",
        "label": "M4 recursive child RLM",
        "focus": ["queryBridge", "recursiveChild", "leafChild", "sessionKernel"],
        "note": "Depth below the configured cap creates a child DSH Session with its own rlm_eval kernel; the leaf remains a one-shot child."
      },
      {
        "id": "authority-lifecycle",
        "label": "Authority and lifecycle",
        "focus": ["agentLoop", "rlmEval", "sessionKernel", "queryBridge", "recursiveChild"],
        "note": "DSH owns Agent turns and Session logs; dsh-rlm owns only Session kernels, managed context state, and query cleanup."
      }
    ]
  },
