  "cards": [
    {
      "dot": "cyan",
      "title": "M3 Context Contract",
      "items": [
        "Loader sends only a path descriptor; user code may still return context",
        "Load succeeds atomically or preserves the previous managed context",
        "No URL fetch, glob, directory walk, attachment domain, or snapshot"
      ]
    },
    {
      "dot": "violet",
      "title": "M4 Recursion Contract",
      "items": [
        "Root depth is 0; maxDepth=1 preserves today's one-shot behavior",
        "Every recursive child owns a separate DSH Session and Python kernel",
        "The max-depth leaf has no rlm_eval tool and cannot recurse"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared Safety",
      "items": [
        "Caller cancellation and cell timeout quiesce the whole owned child branch",
        "Official DSH lineage, tool restriction, model route, and Session log stay authoritative",
        "M3 integrates before M4 starts; each milestone has its own RED and live Profile proof"
      ]
    }
  ]
